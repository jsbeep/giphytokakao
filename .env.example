# ───────── Server only (never sent to the browser) ─────────

# Default GIPHY key(s) used when a visitor hasn't saved their own key in Settings.
# Comma-separated to rotate to the next key once one hits its rate limit.
# Leave empty to require every visitor to bring their own key.
GIPHY_API_KEY="your-giphy-api-key,your-second-giphy-api-key"
GIPHY_TREND_LIMIT="15"
GIPHY_SEARCH_LIMIT="8"

# Per-IP quota for the default key: DEFAULT_KEY_RATE_LIMIT requests per DEFAULT_KEY_RATE_WINDOW_SEC.
# 0 disables the default key (same effect as leaving GIPHY_API_KEY empty).
DEFAULT_KEY_RATE_LIMIT="30"
DEFAULT_KEY_RATE_WINDOW_SEC="86400"

# Optional: Upstash Redis REST credentials so the quota is shared across serverless instances.
# Without them the counter lives in each function instance's memory (fine for local dev).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ───────── Public (VITE_*: bundled into the browser JS) ─────────

# Kakao JavaScript key. Restrict it to your domains in Kakao Developers > Platform > Web.
VITE_KAKAO_APP_KEY="your-kakao-javascript-key"
# Kakao message template ID(s): one ID for every GIF, or five IDs for ratios 1:2, 3:4, 1:1, 4:3, 2:1 (width:height)
VITE_KAKAO_TEMPLATE_IDS="100001,100002,100003,100004,100005"

# Deployed origin, no trailing slash. Used for canonical/og:url, robots.txt, sitemap.xml, llms.txt.
VITE_SITE_URL="https://your-app.vercel.app"
# Optional: GitHub link on the home screen, contact email in Settings, Google Search Console verification
VITE_GITHUB_URL=""
VITE_CONTACT_EMAIL=""
VITE_GOOGLE_SITE_VERIFICATION=""

# How many recent searches to cache in localStorage (5 min TTL)
VITE_SEARCH_CACHE_LIMIT="5"
